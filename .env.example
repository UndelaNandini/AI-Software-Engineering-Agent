# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# LLM Providers (OpenAI, Gemini, Anthropic)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Storage & DB (for Milestone 2+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swe_agent
REDIS_URL=redis://localhost:6379/0

# Agent Execution Limits
MAX_REPAIR_ATTEMPTS=3
EXECUTION_TIMEOUT_SECONDS=60
SANDBOX_CONTAINER_IMAGE=python:3.11-slim
